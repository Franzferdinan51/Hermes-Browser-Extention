{
  "manifest_version": 3,
  "name": "Hermes Agent — Browser Companion",
  "short_name": "Hermes",
  "version": "0.2.0",
  "description": "Connect Hermes to the browser over AG-UI with searchable model discovery, page context, streaming responses, and permission-aware DOM actions.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8965/*",
    "http://localhost:8965/*",
    "ws://127.0.0.1:8965/*",
    "ws://localhost:8965/*"
  ],
  "background": {
    "service_worker": "lib/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Hermes side panel"
  },
  "options_page": "ui/options.html",
  "side_panel": {
    "default_path": "ui/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/page-reader.js",
        "lib/page-actor.js",
        "lib/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/page-reader.js", "lib/page-actor.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}