# Hermes Browser bridge configuration.
# The bridge binds to 127.0.0.1 only. Most values are optional: it auto-loads
# Hermes's WebUI password from ~/.hermes/.hermes-webui.env.

# Port the bridge listens on (default 8965)
PORT=8965

# Hermes WebUI base URL (default http://127.0.0.1:8787)
HERMES_URL=http://127.0.0.1:8787

# Hermes WebUI password. If unset, loaded from ~/.hermes/.hermes-webui.env.
HERMES_PASSWORD=

# Optional token protecting BOTH bridge HTTP and WebSocket endpoints.
# If set here, paste the same value into the extension's Bridge auth token field.
# Use a long random value; do not reuse a provider/API key.
BRIDGE_AUTH_TOKEN=

# Hermes model + provider passed with each chat request
MODEL=qwen3.5-9b
MODEL_PROVIDER=lmstudio

# Optional Hermes workspace path to use for browser sessions
WORKSPACE=