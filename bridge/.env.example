# Hermes Browser bridge configuration.
# All values are optional — the bridge auto-loads Hermes's WebUI password from
# ~/.hermes/.hermes-webui.env, and defaults to model "qwen3.5-9b" on your
# local Hermes instance. Set these only to override.

# Port the bridge listens on (default 8965)
PORT=8965

# Hermes WebUI base URL (default http://127.0.0.1:8787)
HERMES_URL=http://127.0.0.1:8787

# Hermes WebUI password. If unset, loaded from ~/.hermes/.hermes-webui.env.
HERMES_PASSWORD=

# Hermes model + provider passed with each chat request
MODEL=qwen3.5-9b
MODEL_PROVIDER=lmstudio

# Optional Hermes workspace path to use for browser sessions
WORKSPACE=